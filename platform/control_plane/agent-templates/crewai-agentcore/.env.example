# Bedrock model identifier (cross-region inference profile). CrewAI's LiteLLM layer needs a
# provider prefix, so src/config.py prepends `bedrock/` — set the bare id here, as the platform's
# registry stores it.
MODEL_ID=us.anthropic.claude-sonnet-4-6

# AWS region for Bedrock
AWS_REGION=us-east-1

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Langfuse observability — INJECTED BY THE PLATFORM at provisioning; you normally do NOT set these
# by hand. The platform provisions one Langfuse project + key per agent and injects the NON-SECRET
# host + Secrets Manager secret NAME here; the agent reads the {public_key, secret_key} pair from
# Secrets Manager at import (NEVER a hardcoded literal). Leave empty to run without observability
# (the agent still works). NEVER put a Langfuse key value in this file.
LANGFUSE_HOST=
LANGFUSE_SECRET_NAME=
