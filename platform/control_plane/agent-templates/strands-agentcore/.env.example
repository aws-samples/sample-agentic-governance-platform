# Bedrock model identifier (cross-region inference profile)
MODEL_ID=us.anthropic.claude-sonnet-4-6

# AWS region for Bedrock
AWS_REGION=us-east-1

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Langfuse observability (E26/T10) — INJECTED BY THE PLATFORM at provisioning; you normally do
# NOT set these by hand. The platform provisions one Langfuse project + key per agent and injects
# the NON-SECRET host + Secrets Manager secret NAME here; the agent reads the {public_key,
# secret_key} pair from Secrets Manager at import (NEVER a hardcoded literal). Leave empty to run
# without observability (the agent still works). NEVER put a Langfuse key value in this file.
LANGFUSE_HOST=
LANGFUSE_SECRET_NAME=
