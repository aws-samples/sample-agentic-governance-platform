# Agentic Governance Platform — Backend local dev environment template
# Copy to `.env` (gitignored) and fill in. Pydantic Settings reads .env by
# convention. Every key here is a real field on `src/core/config.Settings`.
# Where the values come from: the repo root README's "Create the Entra app
# registrations" step.

# === Entra ID — tenant identity ===
ENTRA_TENANT_ID=

# === Entra ID — inbound user-JWT validation ===
# ENTRA_AUDIENCE is the backend app registration's Application ID URI, and it must
# be byte-identical to `entra_audience` in the Terraform tfvars and to the URI half
# of the frontend's VITE_ENTRA_SPA_SCOPE. Mismatch = every API call 401s.
ENTRA_AUDIENCE=api://agp
ENTRA_SPA_CLIENT_ID=

# === Entra ID — backend Graph client (confidential) ===
ENTRA_BACKEND_CLIENT_ID=
# The actual secret VALUE — Microsoft only shows it once at creation time.
# Never commit. Local-dev only; in ECS the task definition injects this var
# from AWS Secrets Manager natively (no boto3 call from app code).
ENTRA_BACKEND_CLIENT_SECRET=

# === Platform app role names ===
ENTRA_ROLE_ADMIN=Platform.Admin
ENTRA_ROLE_OPERATOR=Platform.Operator
ENTRA_ROLE_VIEWER=Platform.Viewer

# === Auth provider switch ===
AUTH_PROVIDER=entra

# === AWS — local dev ===
# boto3 uses the default credential chain — there is deliberately no access-key or
# account-id key here: a placeholder credential in a checked-in file outranks the
# real ambient one and breaks the deploy in a way that is very hard to see.
AWS_REGION=us-east-1
