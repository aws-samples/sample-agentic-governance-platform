# Terraform secrets — Agentic Governance Platform (dev)
#
# 1. Copy this file to `secrets.auto.tfvars` (no `.example` suffix).
# 2. Replace the placeholder with the real client secret VALUE from the Entra portal.
# 3. Run `terraform apply` — Terraform auto-loads any `*.auto.tfvars` file in
#    this directory; no `-var-file` flag needed.
#
# `secrets.auto.tfvars` is gitignored via `**/*.tfvars` in the repo .gitignore.
# Verify with: git check-ignore -v secrets.auto.tfvars
#
# To rotate: generate a new secret in Entra → update this file → re-apply.
#
# Where the tenant/app IDs come from — the app registrations you create in Entra
# before the first apply. See "Bootstrapping" in the repository README.

# === Auth provider ===
# "entra" is the only accepted value (Cognito was removed; variables.tf validates
# this). It is also the default, so this line is optional.
auth_provider = "entra"

# === Entra ID — tenant + apps ===
entra_tenant_id = "00000000-0000-0000-0000-000000000001"
# The Application ID URI you set on the app registration that exposes the API scope
# (the backend app reg — see the README). This value is YOUR choice, but it must be
# byte-identical in three places or every API call returns 401 with nothing naming the
# culprit: the Application ID URI in Entra, this variable, and the URI half of
# `VITE_ENTRA_SPA_SCOPE` in frontend/.env.
entra_audience = "api://agp"
# SPA app reg client ID — accepted as an alternative `aud` for MSAL access tokens.
entra_spa_client_id = "00000000-0000-0000-0000-000000000002"

# === Entra ID — Backend Graph Client ===
entra_backend_client_id = "00000000-0000-0000-0000-000000000003"
# Paste the real secret VALUE from the Entra portal here in your local
# secrets.auto.tfvars (gitignored). Do NOT commit a real secret in this example.
entra_backend_client_secret = "REPLACE_WITH_CLIENT_SECRET_FROM_ENTRA_PORTAL"



# === Langfuse admin bootstrap user ===
# Replace both values in your local secrets.auto.tfvars (gitignored). Never commit a real password.
langfuse_admin_password = "REPLACE_WITH_A_STRONG_PASSWORD"
langfuse_admin_email    = "admin@example.com"