# Agentic Governance Platform — Frontend local dev environment template
# Copy to `.env.local` (gitignored) and fill in. Where each value comes from:
#   docs/entra-setup.md

# === Entra ID — tenant identity ===
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000001
VITE_ENTRA_TENANT_DOMAIN=contoso.onmicrosoft.com

# === Entra ID — SPA app (frontend uses these via MSAL) ===
VITE_ENTRA_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000002
VITE_ENTRA_SPA_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_ENTRA_SPA_SCOPE=api://agp/Access.Default

# === Auth provider switch (must match backend's AUTH_PROVIDER) ===
VITE_AUTH_PROVIDER=entra