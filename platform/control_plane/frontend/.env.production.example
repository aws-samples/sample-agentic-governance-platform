# Agentic Governance Platform — Frontend production build template
#
# Copy to `.env.production` (gitignored) only if you build the SPA by hand
# (`npm run build` / `deploy-frontend.sh`). `deploy-full.sh` writes this exact
# set of keys into `.env.production` for you: it always sets VITE_API_URL and
# VITE_AUTH_PROVIDER from Terraform outputs, and it DERIVES
# VITE_ENTRA_SPA_REDIRECT_URI from the `frontend_url` output whenever your own
# value is missing or still an unfilled placeholder. The rest are carried over
# verbatim from your own files.
# Precedence when it resolves those keys: exported shell env first, then
# `.env.production.local`, `.env.local`, `.env`, `.env.production`.
#
# These seven keys are the complete set the SPA reads — see
# `src/vite-env.d.ts`. Add nothing else here; Vite bakes them into the bundle,
# so never put a secret in this file.
# Where each Entra value comes from: `docs/entra-setup.md`.

# Deployed control-plane API Gateway URL:
#   terraform -chdir=../infrastructure output -raw api_endpoint
VITE_API_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/dev

# Must match the backend's AUTH_PROVIDER.
VITE_AUTH_PROVIDER=entra

# === Entra ID — tenant identity ===
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000001
VITE_ENTRA_TENANT_DOMAIN=contoso.onmicrosoft.com

# === Entra ID — SPA app (frontend uses these via MSAL) ===
VITE_ENTRA_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000002
# The CloudFront domain, which is only knowable after the first apply:
#   terraform -chdir=../infrastructure output -raw frontend_url
# The SAME value must be registered as a redirect URI on the SPA app reg.
VITE_ENTRA_SPA_REDIRECT_URI=https://<cloudfront-domain>.cloudfront.net/auth/callback
# <application-id-uri>/<scope-name>. The URI part must equal `entra_audience` in
# infrastructure/secrets.auto.tfvars and the Application ID URI on the BACKEND
# app reg in Entra — all three byte-identical, or every API call returns 401.
VITE_ENTRA_SPA_SCOPE=api://agp/Access.Default
