# === API endpoint ===
# The deployed control-plane API Gateway URL. After the first deploy:
#   terraform -chdir=../infrastructure output -raw api_endpoint
# `deploy-full.sh` also writes this value into `.env.production` for you, so it only
# has to be set here for `npm run dev` or a standalone `deploy-frontend.sh` run.
VITE_API_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/dev

# === Entra ID — tenant identity ===
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000001
VITE_ENTRA_TENANT_DOMAIN=contoso.onmicrosoft.com

# === Entra ID — SPA app (frontend uses these via MSAL) ===
VITE_ENTRA_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000002
# Not knowable until after the first `terraform apply` — it is the CloudFront domain:
#   terraform -chdir=../infrastructure output -raw frontend_url
# The SAME value must also be registered as a redirect URI on the SPA app reg.
VITE_ENTRA_SPA_REDIRECT_URI=https://<cloudfront-domain>.cloudfront.net/auth/callback
# <application-id-uri>/<scope-name>. The URI part must equal `entra_audience` in
# infrastructure/secrets.auto.tfvars and the Application ID URI in Entra — all three
# or every API call returns 401. See "Bootstrapping" in the repo README.
VITE_ENTRA_SPA_SCOPE=api://agp/Access.Default

# === Auth provider switch (must match backend's AUTH_PROVIDER) ===
VITE_AUTH_PROVIDER=entra
